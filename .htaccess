# Activa la reescritura de URLs
RewriteEngine On

# Reescribe URLs sin extensión a sus archivos .html si existen
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Redirige las URLs con .html a la versión sin extensión (opcional pero recomendado para SEO)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html\sHTTP/
RewriteRule ^ %1 [R=301,L]